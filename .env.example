# =============================================================
# 환경변수 예시 — 키 목록만 담는다.
#
# 실제 값은 이 파일을 복사한 .env 에 넣는다:
#     cp .env.example .env
#
# 이 리포는 public 이다. 실제 접속 정보·비밀번호를 이 파일에 적지 말 것.
# .env 는 .gitignore 에 등록돼 있다.
# =============================================================

# --- RDS (PostgreSQL) -----------------------------------------
# 엔드포인트는 AWS 콘솔 > RDS > 데이터베이스 > 연결 & 보안 탭에서 확인한다.
# 호스트명 자체가 공격 표면이므로 예시에는 실제 식별자를 넣지 않는다.
DB_HOST=ats-db.xxxxxxxxxxxx.ap-northeast-2.rds.amazonaws.com
DB_PORT=5432
DB_NAME=ats
DB_USER=ats_app
DB_PASSWORD=

# 애플리케이션이 실제로 붙을 때 쓰는 마스터 계정이 아니라,
# 필요한 스키마에만 권한을 준 전용 계정을 쓴다.

# SSL 은 require 이상으로 둔다. RDS 는 기본적으로 TLS 를 지원한다.
DB_SSLMODE=require

# SQLAlchemy / FastAPI 에서 쓰는 단일 URL 형태.
# 위 항목들로 조립해도 되고, 이 값만 써도 된다.
DATABASE_URL=postgresql://ats_app:CHANGE_ME@ats-db.xxxxxxxxxxxx.ap-northeast-2.rds.amazonaws.com:5432/ats?sslmode=require

# 커넥션 풀 — 인스턴스 사양에 맞춰 조정한다.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
